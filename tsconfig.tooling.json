{
  "//": "Root-level tooling and cross-package acceptance tests. Emits only declarations into a git-ignored cache.",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".tsbuild/tooling",
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["vitest.config.ts", "tests/**/*.ts", "scripts/**/*.ts", "apps/admin/vite.config.ts"],
  "references": [
    {
      "path": "./packages/config"
    },
    {
      "path": "./packages/i18n"
    },
    {
      "path": "./packages/platform"
    },
    {
      "path": "./packages/database"
    },
    {
      "path": "./packages/domain"
    },
    {
      "path": "./packages/runtime"
    },
    {
      "path": "./apps/bot"
    },
    {
      "path": "./apps/worker"
    },
    {
      "path": "./apps/api"
    }
  ]
}
