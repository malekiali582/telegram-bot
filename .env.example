# ─────────────────────────────────────────────────────────────
# «لولو» — نمونهٔ متغیرهای محیطی
# این فایل را به .env کپی و مقادیر را پر کنید. هیچ مقدار واقعی را commit نکنید.
# ─────────────────────────────────────────────────────────────

# development | production | test
NODE_ENV=development
# trace | debug | info | warn | error  (توکن، رمز و cookie هرگز لاگ نمی‌شوند)
LOG_LEVEL=info

# ── PostgreSQL (مرجع قطعی موجودی و زمان‌بندی) ──
POSTGRES_USER=lulu
# الزامی؛ یک رمز طولانی تصادفی بگذارید
POSTGRES_PASSWORD=
POSTGRES_DB=lulu
POSTGRES_PORT=5432
DATABASE_URL=postgres://lulu:CHANGE_ME@127.0.0.1:5432/lulu
# اختیاری: اگر ست شود، تست‌ها (به‌جای PGlite) روی این Postgres واقعی هم اجرا می‌شوند.
# دیتابیس جداگانه بدهید؛ تست‌ها جدول‌ها را پاک می‌کنند.
TEST_DATABASE_URL=

# ── Redis (فقط صف/کش/محدودیت نرخ؛ هرگز مرجع پول نیست) ──
# الزامی برای docker compose
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0

# ── بات تلگرام ──
# توکن از BotFather. هرگز در مخزن یا لاگ قرار نگیرد.
TELEGRAM_BOT_TOKEN=
# polling (توسعه) | webhook (انتشار) — هرگز هم‌زمان فعال نیستند
TELEGRAM_MODE=polling
# فقط در حالت webhook: آدرس عمومی HTTPS که API روی آن در دسترس است
PUBLIC_BASE_URL=https://example.com
# فقط در حالت webhook: رشتهٔ تصادفی 1 تا 256 کاراکتر [A-Za-z0-9_-]
# تلگرام آن را در هدر X-Telegram-Bot-Api-Secret-Token برمی‌گرداند
TELEGRAM_WEBHOOK_SECRET=

# ── API و پنل مدیریت ──
API_HOST=127.0.0.1
API_PORT=3000
# مبدأ مجاز پنل (برای CORS و بررسی Origin)
ADMIN_ORIGIN=http://localhost:5173
# کلید امضای نشست و CSRF؛ حداقل ۳۲ بایت تصادفی (مثلاً: openssl rand -base64 48)
SESSION_SECRET=
# در انتشار پشت HTTPS حتماً true
COOKIE_SECURE=false

# ── ساخت مدیر اولیهٔ پنل (فقط با اسکریپت admin:bootstrap خوانده می‌شود) ──
# پس از ساخت حساب، این دو را از .env پاک کنید.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# ── worker ──
# فاصلهٔ اجرای jobهای دوره‌ای (میلی‌ثانیه)
WORKER_SETTLE_INTERVAL_MS=60000
WORKER_OUTBOX_INTERVAL_MS=1000

# ── محتوای روح‌ها ──
GHOSTS_INCOMING_PATH=content/ghosts/incoming.json
# فقط در توسعه: اجازهٔ seed بستهٔ نمونهٔ برچسب‌دار. در production نادیده گرفته می‌شود.
ALLOW_DEV_SEED=false
