# ─────────────────────────────────────────────────────────────
# «لولو» — نمونهٔ متغیرهای محیطی
# این فایل را به .env کپی و مقادیر را پر کنید. هیچ مقدار واقعی را commit نکنید.
#
# اجرای توسعه روی سیستم خودتان (npm run dev) فقط TELEGRAM_BOT_TOKEN را لازم دارد؛
# دیتابیس محلی خودکار ساخته می‌شود و بقیهٔ این فایل برای آن لازم نیست.
# ─────────────────────────────────────────────────────────────

# development | production | test
NODE_ENV=development
# trace | debug | info | warn | error  (توکن، رمز و cookie هرگز لاگ نمی‌شوند)
LOG_LEVEL=info

# ── PostgreSQL ──
# تنها سرویس لازم: مرجع موجودی، زمان‌بندی jobها، وضعیت کارها، outbox و محدودیت نرخ.
# نسخهٔ اول به Redis یا BullMQ نیاز ندارد.
POSTGRES_USER=lulu
# الزامی؛ یک رمز طولانی تصادفی بگذارید
POSTGRES_PASSWORD=
POSTGRES_DB=lulu
POSTGRES_PORT=5432
DATABASE_URL=postgres://lulu:CHANGE_ME@127.0.0.1:5432/lulu
# Postgres واقعی برای تست؛ پیش از هر انتشار الزامی است. تست‌های هم‌زمانی و تراکنش فقط روی آن
# واقعاً اجرا می‌شوند و PGlite تأیید نهایی نیست. دیتابیس جدا بدهید؛ تست‌ها جدول‌ها را پاک می‌کنند.
TEST_DATABASE_URL=

# ── بات تلگرام ──
# توکن از BotFather. هرگز در مخزن یا لاگ قرار نگیرد.
TELEGRAM_BOT_TOKEN=
# polling (توسعه) | webhook (انتشار) — هرگز هم‌زمان فعال نیستند
TELEGRAM_MODE=polling
# فقط در حالت webhook: آدرس عمومی HTTPS که API روی آن در دسترس است
PUBLIC_BASE_URL=https://example.com
# فقط در حالت webhook: رشتهٔ تصادفی 1 تا 256 کاراکتر [A-Za-z0-9_-]
# تلگرام آن را در هدر X-Telegram-Bot-Api-Secret-Token برمی‌گرداند
TELEGRAM_WEBHOOK_SECRET=
# فقط در حالت webhook: سرور محلی که reverse proxy (HTTPS) درخواست‌ها را به آن می‌دهد
TELEGRAM_WEBHOOK_HOST=127.0.0.1
TELEGRAM_WEBHOOK_PORT=8443

# ── حالت توسعه (npm run dev) ──
# پورت PostgreSQL محلی که خودکار اجرا می‌شود (اگر اشغال بود عوضش کنید)
DEV_DB_PORT=54329
# pretty (خوانا برای ترمینال) | json
LOG_FORMAT=pretty

# ── API و پنل مدیریت ──
API_HOST=127.0.0.1
API_PORT=3000
# مبدأ مجاز پنل (برای CORS و بررسی Origin)
ADMIN_ORIGIN=http://localhost:5173
# کلید امضای نشست و CSRF؛ حداقل ۳۲ بایت تصادفی (مثلاً: openssl rand -base64 48)
SESSION_SECRET=
# در انتشار پشت HTTPS حتماً true
COOKIE_SECURE=false

# ── ساخت مدیر اولیهٔ پنل (فقط با اسکریپت admin:bootstrap خوانده می‌شود) ──
# پس از ساخت حساب، این دو را از .env پاک کنید.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# ── worker ──
# فاصلهٔ بررسی jobهای دوره‌ای و outbox در Postgres (میلی‌ثانیه)
WORKER_SETTLE_INTERVAL_MS=60000
WORKER_OUTBOX_INTERVAL_MS=1000

# ── محتوای روح‌ها ──
GHOSTS_INCOMING_PATH=content/ghosts/incoming.json
# فقط در توسعه: اجازهٔ seed بستهٔ نمونهٔ برچسب‌دار. در production نادیده گرفته می‌شود.
ALLOW_DEV_SEED=false
