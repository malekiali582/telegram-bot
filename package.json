{
  "name": "lulu",
  "private": true,
  "description": "بازی گروهی «لولو» برای تلگرام، با بک‌اند مشترک، worker و پنل مدیریت فارسی",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "build": "tsc -b && npm run build --workspaces --if-present",
    "clean": "tsc -b --clean",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm test && npm run test:pg",
    "test:pg": "vitest run --mode pg",
    "dev": "node --conditions=@lulu/source --import tsx scripts/dev.ts",
    "dev:panel": "node --conditions=@lulu/source --import tsx scripts/dev-panel.ts",
    "bot:start": "node apps/bot/dist/main.js",
    "worker:start": "node apps/worker/dist/main.js",
    "api:start": "node apps/api/dist/main.js",
    "dev:grant": "node --conditions=@lulu/source --import tsx scripts/dev-grant.ts",
    "dev:doctor": "node --conditions=@lulu/source --import tsx scripts/dev-doctor.ts",
    "admin:bootstrap": "node --conditions=@lulu/source --import tsx scripts/admin-bootstrap.ts",
    "backup:create": "node --conditions=@lulu/source --import tsx scripts/backup.ts create",
    "backup:restore": "node --conditions=@lulu/source --import tsx scripts/backup.ts restore",
    "simulate": "node --conditions=@lulu/source --import tsx scripts/simulate.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
